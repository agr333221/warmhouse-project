@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Контекстная диаграмма системы «Тёплый дом» (As-Is)

Person(user, "Пользователь", "Владелец дома, управляет отоплением через веб")
System_Ext(sensor, "Датчики отопления", "Передают температуру по запросу сервера")

System(monolith, "Go Монолит", "Управление отоплением, мониторинг температуры, веб-интерфейс\nСинхронное взаимодействие, PostgreSQL")

Rel_R(user, monolith, "Управляет отоплением / просматривает температуру", "HTTPS")
Rel_R(monolith, sensor, "Опрашивает температуру", "Протокол датчиков (MQTT/HTTP)")
Rel_L(sensor, monolith, "Отдаёт значение температуры", "Протокол датчиков")

@enduml
