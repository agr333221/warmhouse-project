@startuml context
!include <C4/C4_Context>

LAYOUT_WITH_LEGEND()

title Диаграмма контекста (C4 Level 1) — система «Тёплый дом» (As-Is)

Person(user, "Пользователь", "Владелец дома. Управляет отоплением и просматривает температуру через веб-интерфейс")
Person(operator, "Специалист по подключению", "Выезжает на объект и подключает систему отопления дома к системе")

System(smartHome, "Smart Home (монолит)", "Монолитное приложение на Go + PostgreSQL. Управление отоплением и мониторинг температуры. Всё взаимодействие синхронное")

System_Ext(heatingSystem, "Система отопления дома", "Датчики температуры и реле управления отоплением, установленные в домах")

Rel(user, smartHome, "Включает/выключает отопление, задаёт целевую температуру, смотрит текущую температуру", "HTTPS")
Rel(operator, smartHome, "Регистрирует дом и датчики при подключении", "HTTPS")
Rel(smartHome, heatingSystem, "Отправляет команды управления отоплением (сервер -> датчик)", "Синхронные запросы")
Rel(smartHome, heatingSystem, "Опрашивает датчики температуры (сервер -> датчик)", "Синхронные запросы")

@enduml
