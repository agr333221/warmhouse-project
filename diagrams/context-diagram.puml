@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Контекстная диаграмма системы «Тёплый дом» (As-Is)

Person(user, "Пользователь", "Владелец дома, управляет отоплением/смотрит температуру через веб-интерфейс")
System_Ext(heating_devices, "Контроллеры отопления и датчики", "Исполнительные механизмы и сенсоры в домах")

System(monolith, "Go Монолит", "Единое приложение: веб-фронт, API, работа с PostgreSQL.\nСинхронный опрос и прямое управление устройствами.")

Rel_R(user, monolith, "Отправляет команды (вкл/выкл отопление)\nЗапрашивает текущую температуру", "HTTPS")

Rel_R(monolith, heating_devices, "Передаёт управляющие команды\n(вкл/выкл, запрос температуры)", "Синхронный протокол")
Rel_L(heating_devices, monolith, "Возвращает статус выполнения команд\nОтдаёт данные температуры", "Синхронный протокол")

@enduml