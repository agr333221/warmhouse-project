@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Контейнерная диаграмма целевой архитектуры (To-Be) — Переход от монолита к микросервисам

' === Внешние акторы и системы ===
Person(user, "Пользователь", "Владелец дома, управляет устройствами через веб/мобильное приложение")
System_Ext(iot_devices, "IoT-устройства", "Датчики температуры, реле освещения, приводы ворот, камеры")
System_Ext(partner_systems, "Системы партнёров", "Производители устройств, предоставляют спецификации и драйверы")

' === Legacy система (старый монолит) ===
Container(monolith, "Go Монолит (Legacy)", "Go + PostgreSQL", "Существующее приложение: управление отоплением, мониторинг температуры, веб-интерфейс\nПостепенно вытесняется микросервисами (Strangler Fig)")

' === Новые микросервисы (To-Be) ===
Container(gateway, "API Gateway", "Python/FastAPI", "Единая точка входа, маршрутизация, JWT-аутентификация, rate-limiting")

Container(identity_svc, "Identity Service", "Python/FastAPI", "Управление пользователями, домами, подписками, ролями (RBAC)")
Container(device_svc, "Device Service", "Python/FastAPI", "Реестр устройств, самопривязка, статусы, адаптеры протоколов")
Container(heating_svc, "Heating Service", "Python/FastAPI", "Бизнес-логика отопления (вынесена из монолита)")
Container(telemetry_svc, "Telemetry Service", "Python/FastAPI", "Ingest телеметрии, валидация, хранение временных рядов")
Container(automation_svc, "Automation Service", "Python/FastAPI", "Пользовательские сценарии, правила IF-THEN, обработка событий")

' === Базы данных и брокеры ===
ContainerDb(monolith_db, "PostgreSQL (Legacy DB)", "PostgreSQL 15", "Существующая БД монолита: heating, temperature, legacy users")
ContainerDb(postgres, "PostgreSQL (New)", "PostgreSQL 15", "Новая БД: users, houses, devices, configs, rules")
ContainerDb(timescaledb, "TimescaleDB", "PostgreSQL + Timescale", "Хранение телеметрии: метрики, временные ряды")
ContainerQueue(broker, "RabbitMQ", "RabbitMQ 3.12", "Брокер сообщений: очереди commands, telemetry, events")

' === Связи: Пользователь → Gateway ===
Rel(user, gateway, "HTTPS / WebSocket", "Запросы управления и мониторинга")

' === Gateway маршрутизирует между монолитом и новыми сервисами ===
Rel(gateway, monolith, "REST", "Legacy-запросы (постепенно сокращаются)")
Rel(gateway, identity_svc, "REST / gRPC", "Аутентификация и авторизация")
Rel(gateway, device_svc, "REST", "Управление устройствами")
Rel(gateway, heating_svc, "REST", "Управление отоплением (новый сервис)")
Rel(gateway, telemetry_svc, "REST", "Запрос телеметрии")
Rel(gateway, automation_svc, "REST", "Настройка сценариев")

' === Монолит взаимодействует со своей БД и устройствами ===
Rel(monolith, monolith_db, "JDBC / SQL", "CRUD: heating, temperature")
Rel(monolith, iot_devices, "HTTP / Custom", "Синхронный опрос температуры и управление (legacy)")

' === Новые сервисы взаимодействуют с новыми БД ===
Rel(identity_svc, postgres, "JDBC / SQL", "CRUD: users, houses, subscriptions")
Rel(device_svc, postgres, "JDBC / SQL", "CRUD: devices, device_types, mappings")
Rel(heating_svc, postgres, "JDBC / SQL", "CRUD: heating_configs, schedules")
Rel(telemetry_svc, timescaledb, "JDBC / SQL", "INSERT/SELECT: metrics")
Rel(automation_svc, postgres, "JDBC / SQL", "CRUD: scenarios, triggers")

' === Асинхронное взаимодействие через брокер ===
Rel(broker, device_svc, "AMQP", "Потребляет: device.commands")
Rel(broker, heating_svc, "AMQP", "Потребляет: heating.commands")
Rel(telemetry_svc, broker, "AMQP", "Публикует: telemetry.ingest")
Rel(automation_svc, broker, "AMQP", "Потребляет/Публикует: events")

' === Новые устройства работают с новыми сервисами ===
Rel(iot_devices, telemetry_svc, "MQTT / CoAP", "Push телеметрии (новый паттерн)")
Rel(iot_devices, broker, "MQTT", "Прямая публикация событий")
Rel(partner_systems, device_svc, "REST", "Регистрация драйверов / спецификаций")

' === Миграция данных и интеграция ===
Rel(monolith_db, postgres, "Data Sync", "Постепенная миграция данных (users, houses)")
Rel(monolith, device_svc, "REST / Events", "Делегирование управления устройствами")
Rel(monolith, telemetry_svc, "REST / Events", "Делегирование телеметрии")

UpdateElementStyle(monolith, $bgColor="#ffcccb", $borderColor="#dc143c")
UpdateElementStyle(monolith_db, $bgColor="#ffe4e1")
UpdateElementStyle(gateway, $bgColor="#ffffcc")
UpdateElementStyle(broker, $bgColor="#e8f5e9")

@enduml
